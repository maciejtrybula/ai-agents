{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "it-task-master",
  "lsp": true,
  "model": "openai/gpt-5.6-luna",
  "autoupdate": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "./plugins/caveman/plugin.js"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "git log *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git rev-parse": "allow",
      "git rev-parse *": "allow",
      "pnpm --filter *": "allow",
      "pnpm build *": "allow",
      "pnpm test*": "allow",
      "pnpm mobile:lint*": "allow",
      "docker compose build *": "allow",
      "docker compose up *": "allow",
      "docker compose restart": "allow",
      "docker compose restart *": "allow",
      "docker compose ps": "allow",
      "docker compose ps*": "allow",
      "docker compose logs *": "allow",
      "docker compose version *": "allow",
      "grep*": "allow",
      "cat*": "allow",
      "rg*": "allow",
      "sort*": "allow",
      "find*": "allow",
      "head*": "allow",
      "wc*": "allow",
      "test*": "allow",
      "true*": "allow",
      "false*": "allow",
      "echo*": "allow",
      "printf*": "allow",
      "tail*": "allow",
      "exit*": "allow",
      "kill*": "allow",
      "pkill*": "allow",
      "ps*": "allow"
    }
  },
  "agent": {
    "it-task-master": {
      "mode": "primary",
      "tools": {
        "todowrite": true,
        "question": true,
        "read": true,
        "grep": true,
        "glob": true,
        "list": true,
        "lsp": true
      },
      "permission": {
        "edit": "ask",
        "write": "ask"
      }
    }
  },
  "provider": {
    "nvidia-nim": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "${NVIDIA_NIM_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (recommended)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "models": {
        "deepseek-r1:7b": {
          "name": "deepseek-r1:7b"
        },
        "llama3.2": {
          "name": "llama3.2"
        },
        "gemma4:26b": {
          "name": "gemma4 26b"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 coder"
        }
      },
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests,actions"
      ],
      "enabled": true
    },
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "${STITCH_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      },
      "enabled": true
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "blender-mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/maciejtrybula/Projects/ai-agents"
      ],
      "enabled": true
    }
  }
}
