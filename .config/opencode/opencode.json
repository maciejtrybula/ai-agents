{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "it-task-master",
  "lsp": true,
  "model": "openai/gpt-5.6-luna",
  "update": "auto",
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@dietrichgebert/ponytail",
    "./plugins/caveman"
  ],
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "ls*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm --filter *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm build *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm mobile:lint*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm format:check *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pnpm exec prettier *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose build *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose up *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose restart",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose restart *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose ps",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose ps*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose logs *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "docker compose version *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "/Applications/Unity/Hub/Editor/6000.4.1f1/Unity.app/Contents/MacOS/Unity *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "rg*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "sort*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "test*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "true*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "false*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "exit*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "kill*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pkill*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ps*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "exit",
      "effect": "allow"
    }
  ],
  "agents": {
    "it-task-master": {
      "mode": "primary",
      "permissions": [
        {
          "action": "todowrite",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "question",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "list",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lsp",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "ask"
        }
      ]
    }
  },
  "providers": {
    "nvidia-nim": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_NIM_API_KEY}"
      },
      "models": {
        "moonshotai/kimi-k2.5": {
          "name": "Kimi K2.5",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (recommended)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "models": {
        "deepseek-r1:7b": {
          "name": "deepseek-r1:7b"
        },
        "llama3.2": {
          "name": "llama3.2"
        },
        "gemma4:26b": {
          "name": "gemma4 26b"
        },
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 coder"
        }
      },
      "name": "Ollama",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      }
    }
  },
  "mcp": {
    "servers": {
      "github": {
        "type": "local",
        "command": [
          "docker",
          "run",
          "-i",
          "--rm",
          "-e",
          "GITHUB_PERSONAL_ACCESS_TOKEN",
          "ghcr.io/github/github-mcp-server",
          "stdio",
          "--read-only",
          "--toolsets",
          "repos,issues,pull_requests,actions"
        ],
        "disabled": false
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "disabled": false,
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        },
        "disabled": false
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "disabled": false
      },
      "blender": {
        "type": "local",
        "command": [
          "uvx",
          "blender-mcp"
        ],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest",
          "--headless",
          "--isolated"
        ],
        "disabled": false
      },
      "filesystem": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "/Users/maciejtrybula/Projects/ai-agents"
        ],
        "disabled": false
      }
    }
  }
}
