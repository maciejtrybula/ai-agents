.idea
.claude.local.env
.codex.local.env
.opencode.local.env
.DS_Store
.worktrees/

# Generated platform agent copies (single-source of truth from .agents/)
# These dirs are materialized by generate-agents.sh from the canonical
# .agents/*.md sources. Do not edit them by hand.
.claude/agents/
.codex/agents/
.config/opencode/agents/

# Runtime project-local session-handoff output (written by the
# session-handoff skill under a writable git work tree). The user-global
# handoff store lives out-of-repo in the user's XDG state dir
# (~/.local/state/session-handoff/) and needs no entry here.
.claude/handoff/
