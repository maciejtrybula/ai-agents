{
  "model": "sonnet",
  "agent": "it-task-master",
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm build *)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose ps*)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(rg*)",
      "Bash(sort*)",
      "Bash(find*)",
      "Bash(head*)",
      "mcp__github_get_*",
      "mcp__linear_*",
      "mcp__context7_*"
    ]
  },
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests,actions"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    }
  }
}
