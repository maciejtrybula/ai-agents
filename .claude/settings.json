{
  "model": "sonnet",
  "agent": "it-task-master",
  "statusLine": {
    "type": "command",
    "command": "bash \"~/.claude/statusline-command.sh\""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "ponytail@ponytail": true,
    "swift-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "permissions": {
    "allow": [
      "Bash(ls*)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git branch *)",
      "Bash(pnpm --filter *)",
      "Bash(pnpm build *)",
      "Bash(docker compose build *)",
      "Bash(docker compose up *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(docker compose version *)",
      "Bash(grep*)",
      "Bash(cat*)",
      "Bash(rg*)",
      "Bash(sort*)",
      "Bash(find*)",
      "Bash(head*)",
      "Bash(wc*)",
      "Bash(test*)",
      "mcp__github__*",
      "mcp__linear-server__*",
      "mcp__blender__*",
      "mcp__stitch__*",
      "mcp__playwright__*"
    ]
  },
  "mcpServers": {
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "stdio",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests,actions"
      ]
    },
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    },
    "blender": {
      "command": "uvx",
      "args": [
        "blender-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--headless",
        "--isolated"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/maciejtrybula/Projects/ai-agents"
      ]
    }
  }
}
